generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum SessionPlatform {
  ANDROID
  WEB
  IOS
  UNKNOWN
}

model User {
  id                             String                         @id @db.Uuid
  email                          String                         @unique
  fullName                       String
  phone                          String?
  avatarStoragePath              String?
  status                         UserStatus                     @default(ACTIVE)
  roleId                         String                         @db.Uuid
  lastLoginAt                    DateTime?
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt
  deletedAt                      DateTime?
  role                           Role                           @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sessions                       UserSession[]
  passwordCredential             PasswordCredential?
  orders                         Order[]
  couponRedemptions              CouponRedemption[]
  entitlements                   Entitlement[]
  adminGrants                    Entitlement[]                  @relation("AdminGrants")
  auditEventsAsActor             AuditEvent[]                   @relation("AuditActor")
  auditEventsAsTarget            AuditEvent[]                   @relation("AuditTarget")
  broadcastTimeline              BroadcastTimelineEvent[]
  broadcastUserEvents            BroadcastUserEvent[]
  academyMemberships             AcademyMembership[]
  academyEnrollments             AcademyCourseEnrollment[]
  academyInvitationsSent         AcademyInvitation[]            @relation("AcademyInviter")
  academyQrSessionsCreated       AcademyQrSession[]             @relation("QrCreator")
  platformSettingsUpdated        PlatformSetting[]              @relation("PlatformSettingsUpdated")
  systemAuditLogsAsActor         SystemAuditLog[]               @relation("SystemAuditActor")
  securityEventsForUser          SecurityEvent[]                @relation("SecurityEventsForUser")
  securityEventsAsActor          SecurityEvent[]                @relation("SecurityEventsAsActor")
  admissionBatchesCreated        AdmissionBatch[]               @relation("AdmissionBatchCreator")
  admissionRecordsAsStudent      AdmissionRecord[]              @relation("AdmissionStudent")
  admissionRecordsCreated        AdmissionRecord[]              @relation("AdmissionRecordCreator")
  admissionCodesCreated          AdmissionCode[]                @relation("AdmissionCodeCreator")
  sentNotifications              Notification[]                 @relation("SentNotifications")
  receivedNotificationRecipients NotificationRecipient[]        @relation("ReceivedNotificationRecipients")
  notificationIndividualTargets  NotificationIndividualTarget[]
  storageUploads                 StorageUpload[]
  backgroundJobsCreated          BackgroundJob[]                @relation("BackgroundJobCreator")
  contactSubmissions             ContactSubmission[]
  activeAcademyPreference        UserAcademyPreference?
  notificationDeliveries         NotificationDelivery[]

  @@index([roleId])
  @@index([status, createdAt])
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique
  name            String
  description     String
  isSystem        Boolean          @default(true)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  users           User[]
  rolePermissions RolePermission[]
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique
  module          String
  action          String
  description     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@index([module])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserSession {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @db.Uuid
  authSessionId    String          @unique
  deviceName       String?
  platform         SessionPlatform @default(UNKNOWN)
  userAgent        String?
  ipAddress        String?
  location         String?
  createdAt        DateTime        @default(now())
  lastSeenAt       DateTime        @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  refreshTokenHash String?         @db.VarChar(64)
  rotationCounter  Int             @default(0)
  lastRotatedAt    DateTime?
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([userId, lastSeenAt])
}

model PasswordCredential {
  userId            String   @id @db.Uuid
  passwordHash      String
  passwordChangedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

enum CourseStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Course {
  id          String       @id @default(uuid()) @db.Uuid
  academyId   String?      @db.Uuid
  slug        String       @unique
  code        String       @db.VarChar(16)
  name        String
  description String       @default("")
  status      CourseStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  academy             Academy?                  @relation(fields: [academyId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  subjects            Subject[]
  contentItems        ContentItem[]
  contentLocations    ContentLocationSetting[]
  packages            Package[]
  taxonomyChapters    TaxonomyChapter[]
  questions           Question[]
  caseSubQuestions    CaseSubQuestion[]
  orders              Order[]
  entitlements        Entitlement[]
  broadcastTargets    BroadcastCourseTarget[]
  enrollments         AcademyCourseEnrollment[]
  targetNotifications Notification[]
  storageUploads      StorageUpload[]

  @@unique([academyId, code])
  @@index([academyId, status, deletedAt])
  @@index([status, deletedAt])
}

model Subject {
  id        String    @id @default(uuid()) @db.Uuid
  courseId  String    @db.Uuid
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  course           Course            @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  taxonomyChapters TaxonomyChapter[]
  questions        Question[]
  caseSubQuestions CaseSubQuestion[]
  couponTargets    CouponTarget[]
  entitlements     Entitlement[]

  @@index([courseId, deletedAt])
}

enum ContentKind {
  FOLDER
  FILE
}

enum ContentAccessType {
  FREE
  PAID
}

enum ContentEntityType {
  EXAM
  STAGE
  SUBJECT
  CHAPTER
  COURSE
  CATEGORY
  LESSON
  STUDY_MATERIAL
  GOVERNMENT_DOCUMENT
  QUESTION_PAPER
  REFERENCE_MATERIAL
  PREMIUM_NOTE
  MEDIA
  OTHER
}

enum ContentStatus {
  PUBLISHED
  ARCHIVED
}

model ContentItem {
  id       String  @id @default(uuid()) @db.Uuid
  courseId String  @db.Uuid
  parentId String? @db.Uuid

  kind ContentKind
  name String

  size        BigInt  @default(0)
  mimeType    String?
  storagePath String?

  description String             @default("")
  entityType  ContentEntityType?

  accessType ContentAccessType @default(FREE)
  price      Decimal?          @db.Decimal(10, 2)

  status ContentStatus @default(PUBLISHED)

  displayOrder Int @default(0)

  lastOpenedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  course Course       @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parent ContentItem? @relation("ContentHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  children      ContentItem[]            @relation("ContentHierarchy")
  sampleImages  ContentSampleImage[]
  storeSections ContentStoreSection[]
  locations     ContentLocationSetting[]
  packageItems  PackageItem[]
  orderItems    OrderItem[]
  entitlements  Entitlement[]

  @@index([courseId, parentId, deletedAt, displayOrder])
  @@index([kind, accessType])
  @@index([status])
  @@index([storagePath])
}

model ContentLocationSetting {
  id       String  @id @default(uuid()) @db.Uuid
  courseId String  @db.Uuid
  folderId String? @db.Uuid

  pageHeading String @default("untitled_page")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course       @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  folder ContentItem? @relation(fields: [folderId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([courseId])
}

enum SampleImageRole {
  PDF_FIRST_PAGE
  ADMIN_PREVIEW
}

model ContentSampleImage {
  id        String          @id @default(uuid()) @db.Uuid
  contentId String          @db.Uuid
  role      SampleImageRole @default(ADMIN_PREVIEW)

  name        String
  mimeType    String
  size        BigInt
  storagePath String

  displayOrder Int @default(0)

  createdAt DateTime @default(now())

  contentItem ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([contentId, role])
  @@index([contentId, displayOrder])
}

model ContentStoreSection {
  id        String @id @default(uuid()) @db.Uuid
  contentId String @db.Uuid

  heading      String
  content      String
  displayOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contentItem ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([contentId, displayOrder])
}

enum MerchandisingMode {
  AUTO
  HYBRID
  MANUAL
}

model StoreMerchandisingSection {
  id              String            @id @default(uuid()) @db.Uuid
  key             String            @unique
  title           String
  subtitle        String?
  mode            MerchandisingMode @default(AUTO)
  limit           Int               @default(8)
  dateWindowDays  Int?
  pinnedItemIds   String[]          @default([])
  excludedItemIds String[]          @default([])
  isEnabled       Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PackageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Package {
  id          String        @id @default(uuid()) @db.Uuid
  courseId    String        @db.Uuid
  title       String
  slug        String
  description String        @default("")
  price       Decimal       @default(0.00) @db.Decimal(10, 2)
  status      PackageStatus @default(DRAFT)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  course           Course                   @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items            PackageItem[]
  orderItems       OrderItem[]
  couponTargets    CouponTarget[]
  entitlements     Entitlement[]
  broadcastTargets BroadcastPackageTarget[]

  @@index([courseId, status, deletedAt])
  @@index([createdAt])
}

model PackageItem {
  id            String   @id @default(uuid()) @db.Uuid
  packageId     String   @db.Uuid
  contentItemId String   @db.Uuid
  displayOrder  Int      @default(0)
  addedAt       DateTime @default(now())

  package     Package     @relation(fields: [packageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([packageId, contentItemId])
  @@index([packageId, displayOrder])
  @@index([contentItemId])
}

model TaxonomyChapter {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @db.Uuid
  subjectId String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course           Course            @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subject          Subject           @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lessons          TaxonomyLesson[]
  questions        Question[]
  caseSubQuestions CaseSubQuestion[]

  @@index([subjectId])
  @@index([courseId])
}

model TaxonomyLesson {
  id        String   @id @default(uuid()) @db.Uuid
  chapterId String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapter          TaxonomyChapter   @relation(fields: [chapterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  topics           TaxonomyTopic[]
  questions        Question[]
  caseSubQuestions CaseSubQuestion[]

  @@index([chapterId])
}

model TaxonomyTopic {
  id        String   @id @default(uuid()) @db.Uuid
  lessonId  String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson           TaxonomyLesson    @relation(fields: [lessonId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  questions        Question[]
  caseSubQuestions CaseSubQuestion[]

  @@index([lessonId])
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionDifficulty {
  FOUNDATION
  INTERMEDIATE
  ADVANCED
}

enum QuestionKind {
  NORMAL_MCQ
  NORMAL_DESCRIPTIVE
  CASE_MCQ
  CASE_DESCRIPTIVE
}

enum CaseClassificationMode {
  ENTIRE_CASE
  INDIVIDUAL_SUB_QUESTIONS
}

model Question {
  id                                 String                 @id @default(uuid()) @db.Uuid
  academyId                          String?                @db.Uuid
  kind                               QuestionKind
  status                             QuestionStatus         @default(DRAFT)
  difficulty                         QuestionDifficulty     @default(INTERMEDIATE)
  questionHtml                       String                 @default("")
  answerHtml                         String                 @default("")
  correctOptionId                    String?                @db.VarChar(1)
  correctExplanationHtml             String                 @default("")
  premiumWrongOptionsExplanationHtml String                 @default("")
  caseHtml                           String                 @default("")
  caseId                             String?
  classificationMode                 CaseClassificationMode @default(ENTIRE_CASE)

  courseId  String? @db.Uuid
  subjectId String? @db.Uuid
  chapterId String? @db.Uuid
  lessonId  String? @db.Uuid
  topicId   String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  academy      Academy?          @relation(fields: [academyId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  course       Course?           @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subject      Subject?          @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  chapter      TaxonomyChapter?  @relation(fields: [chapterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lesson       TaxonomyLesson?   @relation(fields: [lessonId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  topic        TaxonomyTopic?    @relation(fields: [topicId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  options      QuestionOption[]
  subQuestions CaseSubQuestion[]

  @@index([academyId, status, deletedAt])
  @@index([courseId, subjectId, chapterId, lessonId, topicId])
  @@index([kind, status, difficulty, deletedAt])
  @@index([caseId])
  @@index([createdAt])
}

model QuestionOption {
  id            String  @id @default(uuid()) @db.Uuid
  questionId    String? @db.Uuid
  subQuestionId String? @db.Uuid
  optionLabel   String  @db.VarChar(1)
  html          String  @default("")
  displayOrder  Int     @default(0)

  question    Question?        @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subQuestion CaseSubQuestion? @relation(fields: [subQuestionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([questionId])
  @@index([subQuestionId])
}

model CaseSubQuestion {
  id                                 String  @id @default(uuid()) @db.Uuid
  questionId                         String  @db.Uuid
  questionHtml                       String  @default("")
  correctOptionId                    String? @db.VarChar(1)
  correctExplanationHtml             String  @default("")
  premiumWrongOptionsExplanationHtml String  @default("")
  answerHtml                         String  @default("")
  displayOrder                       Int     @default(0)

  courseId  String? @db.Uuid
  subjectId String? @db.Uuid
  chapterId String? @db.Uuid
  lessonId  String? @db.Uuid
  topicId   String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentQuestion Question         @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  course         Course?          @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subject        Subject?         @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  chapter        TaxonomyChapter? @relation(fields: [chapterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lesson         TaxonomyLesson?  @relation(fields: [lessonId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  topic          TaxonomyTopic?   @relation(fields: [topicId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  options        QuestionOption[]

  @@index([questionId, displayOrder])
}

enum OrderStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum RefundStatus {
  NONE
  PENDING
  PARTIAL
  FULL
}

enum OrderAccessStatus {
  PENDING
  GRANTED
  REVOKED
  NOT_APPLICABLE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum CouponDiscountType {
  PERCENT
  FLAT
}

enum CouponScope {
  ALL
  PACKAGES
  SUBJECTS
}

enum LearningResourceType {
  COURSE
  PACKAGE
  LESSON
  PREMIUM_NOTES
  SUBJECT
  OTHER
}

enum EntitlementSource {
  PURCHASE
  ADMIN_GRANT
  SUBSCRIPTION
  PROMOTION
}

enum EntitlementAccessType {
  PERMANENT
  TIME_LIMITED
}

enum EntitlementStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum AuditAction {
  ACCESS_GRANTED
  ACCESS_REVOKED
  ROLE_CHANGED
  ACCOUNT_DISABLED
  ACCOUNT_ENABLED
  SESSIONS_REVOKED
}

model Order {
  id              String            @id @default(uuid()) @db.Uuid
  orderNumber     String            @unique
  userId          String            @db.Uuid
  courseId        String?           @db.Uuid
  currency        String            @default("INR") @db.VarChar(3)
  subtotal        Decimal           @db.Decimal(10, 2)
  discountAmount  Decimal           @default(0.00) @db.Decimal(10, 2)
  totalAmount     Decimal           @db.Decimal(10, 2)
  status          OrderStatus       @default(CREATED)
  refundStatus    RefundStatus      @default(NONE)
  accessStatus    OrderAccessStatus @default(PENDING)
  isComplimentary Boolean           @default(false)
  receiptNumber   String?           @unique
  paymentMethod   String?

  createdAt  DateTime  @default(now())
  paidAt     DateTime?
  refundedAt DateTime?
  updatedAt  DateTime  @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  course       Course?            @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items        OrderItem[]
  payments     Payment[]
  redemptions  CouponRedemption[]
  entitlements Entitlement[]

  @@index([userId, status])
  @@index([courseId, status])
  @@index([createdAt])
}

model OrderItem {
  id            String               @id @default(uuid()) @db.Uuid
  orderId       String               @db.Uuid
  contentItemId String?              @db.Uuid
  packageId     String?              @db.Uuid
  resourceType  LearningResourceType
  titleSnapshot String
  unitPrice     Decimal              @db.Decimal(10, 2)
  quantity      Int                  @default(1)
  totalPrice    Decimal              @db.Decimal(10, 2)

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contentItem ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  package     Package?     @relation(fields: [packageId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderId])
  @@index([contentItemId])
  @@index([packageId])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @db.Uuid
  provider          String
  providerPaymentId String?       @unique
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR") @db.VarChar(3)
  status            PaymentStatus @default(PENDING)
  paymentMethod     String?
  failureReason     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  refunds PaymentRefund[]

  @@index([orderId])
  @@index([status])
}

model PaymentRefund {
  id               String   @id @default(uuid()) @db.Uuid
  paymentId        String   @db.Uuid
  providerRefundId String   @unique
  amount           Decimal  @db.Decimal(10, 2)
  reason           String
  idempotencyKey   String   @unique
  createdAt        DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([paymentId, createdAt])
}

model Coupon {
  id            String             @id @default(uuid()) @db.Uuid
  code          String             @unique
  discountType  CouponDiscountType
  discountValue Decimal            @db.Decimal(10, 2)
  scope         CouponScope        @default(ALL)
  usageCount    Int                @default(0)
  maxUses       Int?
  enabled       Boolean            @default(true)
  expiresAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  targets     CouponTarget[]
  redemptions CouponRedemption[]

  @@index([code])
  @@index([enabled, expiresAt])
}

model CouponTarget {
  id        String  @id @default(uuid()) @db.Uuid
  couponId  String  @db.Uuid
  packageId String? @db.Uuid
  subjectId String? @db.Uuid

  coupon  Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  package Package? @relation(fields: [packageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([couponId])
  @@index([packageId])
  @@index([subjectId])
}

model CouponRedemption {
  id             String   @id @default(uuid()) @db.Uuid
  couponId       String   @db.Uuid
  userId         String   @db.Uuid
  orderId        String   @db.Uuid
  discountAmount Decimal  @db.Decimal(10, 2)
  redeemedAt     DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([couponId, userId])
  @@index([orderId])
}

model Entitlement {
  id               String                @id @default(uuid()) @db.Uuid
  userId           String                @db.Uuid
  resourceType     LearningResourceType
  contentItemId    String?               @db.Uuid
  packageId        String?               @db.Uuid
  subjectId        String?               @db.Uuid
  courseId         String?               @db.Uuid
  resourceTitle    String
  source           EntitlementSource     @default(PURCHASE)
  orderId          String?               @db.Uuid
  accessType       EntitlementAccessType @default(PERMANENT)
  status           EntitlementStatus     @default(ACTIVE)
  grantedAt        DateTime              @default(now())
  expiresAt        DateTime?
  grantedByAdminId String?               @db.Uuid
  reason           String?
  revokedAt        DateTime?

  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  contentItem    ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  package        Package?     @relation(fields: [packageId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subject        Subject?     @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  course         Course?      @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  order          Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  grantedByAdmin User?        @relation("AdminGrants", fields: [grantedByAdminId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId, status])
  @@index([contentItemId, status])
  @@index([packageId, status])
  @@index([orderId])
}

model AuditEvent {
  id              String      @id @default(uuid()) @db.Uuid
  actorId         String      @db.Uuid
  targetStudentId String      @db.Uuid
  action          AuditAction
  reason          String
  before          Json?
  after           Json?
  occurredAt      DateTime    @default(now())

  actor         User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  targetStudent User @relation("AuditTarget", fields: [targetStudentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([targetStudentId, occurredAt])
  @@index([actorId, occurredAt])
}

// ==================================================
// PHASE 7 — BROADCAST & COMMUNICATION ENUMS
// ==================================================

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  EXPIRED
  ARCHIVED
  DISABLED
}

enum BroadcastType {
  ANNOUNCEMENT
  IMPORTANT_NOTICE
  UPDATE
  PROMOTION
  MAINTENANCE
  FEATURE_UPDATE
  ACADEMIC
  STORE
  GENERAL
  CRITICAL_ALERT
}

enum BroadcastPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum BroadcastAudienceKind {
  EVERYONE
  STUDENTS
  COURSES
  PACKAGES
  ACADEMIES
  ACADEMY_STUDENTS
}

enum BroadcastPlatform {
  APP
  WEBSITE
  BOTH
}

enum BroadcastPlacement {
  NOTIFICATION
  HOME
  STORE
  COURSE
  GENERAL
}

enum BroadcastFrequency {
  ONCE
  DAILY
  EVERY_VISIT
  UNTIL_DISMISSED
  ALWAYS_ACTIVE
}

enum BroadcastCtaAction {
  INTERNAL_ROUTE
  EXTERNAL_URL
  STORE
  COURSE
  PACKAGE
  CONTENT
  ACADEMY
}

enum BroadcastPresentation {
  BANNER
  NOTIFICATION
  CARD
  MODAL
  WHATS_NEW
  CRITICAL_ALERT
}

enum BroadcastDisplayOrder {
  AUTOMATIC
  PINNED
  CUSTOM
}

enum BroadcastRepeatBehavior {
  NEVER
  INTERVAL
  CONTINUE
}

enum BroadcastTimelineAction {
  CREATED
  UPDATED
  PUBLISHED
  SCHEDULED
  PAUSED
  RESUMED
  EXPIRED
  ARCHIVED
  DELETED
  AUDIENCE_CHANGED
  DISPLAY_CHANGED
  CTA_CHANGED
  SCHEDULE_CHANGED
  PRIORITY_CHANGED
  DISABLED
  RESTORED
}

enum BroadcastEventType {
  REACHED
  VIEWED
  CLICKED
  DISMISSED
  ACKNOWLEDGED
}

// ==================================================
// PHASE 7 — BROADCAST & COMMUNICATION MODELS
// ==================================================

model Broadcast {
  id                      String                  @id @default(uuid()) @db.Uuid
  academyId               String?                 @db.Uuid
  title                   String
  subtitle                String                  @default("")
  message                 String                  @db.Text
  type                    BroadcastType           @default(ANNOUNCEMENT)
  priority                BroadcastPriority       @default(NORMAL)
  status                  BroadcastStatus         @default(DRAFT)
  disabledFrom            BroadcastStatus?
  platform                BroadcastPlatform       @default(BOTH)
  audienceKind            BroadcastAudienceKind   @default(EVERYONE)
  startAt                 DateTime?
  endAt                   DateTime?
  publishedAt             DateTime?
  frequency               BroadcastFrequency      @default(ONCE)
  dismissible             Boolean                 @default(true)
  presentation            BroadcastPresentation   @default(NOTIFICATION)
  displayOrder            BroadcastDisplayOrder   @default(AUTOMATIC)
  customOrderWeight       Int                     @default(50)
  acknowledgementRequired Boolean                 @default(false)
  repeatBehavior          BroadcastRepeatBehavior @default(NEVER)
  showInWhatsNew          Boolean                 @default(false)

  // Cached Aggregated Analytics Counters
  reachedCount      Int @default(0)
  viewedCount       Int @default(0)
  uniqueViewsCount  Int @default(0)
  clickedCount      Int @default(0)
  dismissedCount    Int @default(0)
  acknowledgedCount Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  academy        Academy?                    @relation(fields: [academyId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  placements     BroadcastPlacementSetting[]
  cta            BroadcastCta?
  image          BroadcastImage?
  courseTargets  BroadcastCourseTarget[]
  packageTargets BroadcastPackageTarget[]
  academyTargets BroadcastAcademyTarget[]
  timeline       BroadcastTimelineEvent[]
  userEvents     BroadcastUserEvent[]

  @@index([academyId, status, deletedAt])
  @@index([status, startAt, endAt, deletedAt])
  @@index([platform, audienceKind])
  @@index([priority, displayOrder])
  @@index([showInWhatsNew, status])
  @@index([createdAt])
}

model BroadcastPlacementSetting {
  id          String             @id @default(uuid()) @db.Uuid
  broadcastId String             @db.Uuid
  placement   BroadcastPlacement

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([broadcastId, placement])
  @@index([broadcastId])
  @@index([placement])
}

model BroadcastCta {
  id          String             @id @default(uuid()) @db.Uuid
  broadcastId String             @unique @db.Uuid
  enabled     Boolean            @default(true)
  text        String
  action      BroadcastCtaAction @default(INTERNAL_ROUTE)
  destination String

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model BroadcastImage {
  id          String   @id @default(uuid()) @db.Uuid
  broadcastId String   @unique @db.Uuid
  name        String
  mimeType    String
  size        BigInt
  storagePath String
  createdAt   DateTime @default(now())

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model BroadcastCourseTarget {
  id          String @id @default(uuid()) @db.Uuid
  broadcastId String @db.Uuid
  courseId    String @db.Uuid

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([broadcastId, courseId])
  @@index([broadcastId])
  @@index([courseId])
}

model BroadcastPackageTarget {
  id          String @id @default(uuid()) @db.Uuid
  broadcastId String @db.Uuid
  packageId   String @db.Uuid

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  package   Package   @relation(fields: [packageId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([broadcastId, packageId])
  @@index([broadcastId])
  @@index([packageId])
}

model BroadcastTimelineEvent {
  id          String                  @id @default(uuid()) @db.Uuid
  broadcastId String                  @db.Uuid
  actorId     String                  @db.Uuid
  action      BroadcastTimelineAction
  description String                  @db.Text
  timestamp   DateTime                @default(now())

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actor     User      @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([broadcastId, timestamp])
  @@index([actorId])
}

model BroadcastUserEvent {
  id          String             @id @default(uuid()) @db.Uuid
  broadcastId String             @db.Uuid
  userId      String             @db.Uuid
  eventType   BroadcastEventType
  occurredAt  DateTime           @default(now())

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([broadcastId, userId, eventType])
  @@index([broadcastId, eventType])
  @@index([userId, broadcastId, eventType])
  @@index([occurredAt])
}

// ==================================================
// PHASE 8 — ACADEMY MULTI-TENANT ENUMS
