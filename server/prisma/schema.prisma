// ==================================================
// PHASE 10 — SYSTEM AUDIT & SECURITY
// ==================================================

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  SESSION_CREATED
  SESSION_REVOKED
  PASSWORD_CHANGED
  ACCOUNT_DISABLED
  ACCOUNT_ENABLED
  SUSPICIOUS_ACTIVITY
  QR_AUTH_SUCCESS
  QR_AUTH_FAILED
}

enum SecurityRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model SystemAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  action      String
  entityType  String
  entityId    String?
  description String   @default("")
  before      Json?
  after       Json?
  metadata    Json?
  actorId     String?  @db.Uuid
  academyId   String?  @db.Uuid
  occurredAt  DateTime @default(now())

  actor   User?    @relation("SystemAuditActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  academy Academy? @relation(fields: [academyId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([actorId])
  @@index([academyId])
  @@index([entityType, entityId])
  @@index([occurredAt])
}

model SecurityEvent {
  id          String            @id @default(uuid()) @db.Uuid
  eventType   SecurityEventType
  riskLevel   SecurityRiskLevel @default(LOW)
  description String            @default("")
  ipAddress   String?
  userAgent   String?
  sessionId   String?           @db.Uuid
  userId      String?           @db.Uuid
  actorId     String?           @db.Uuid
  academyId   String?           @db.Uuid
  metadata    Json?
  occurredAt  DateTime          @default(now())

  user    User?    @relation("SecurityEventsForUser", fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  actor   User?    @relation("SecurityEventsAsActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  academy Academy? @relation(fields: [academyId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId])
  @@index([actorId])
  @@index([academyId])
  @@index([eventType])
  @@index([riskLevel])
  @@index([occurredAt])
}

// ==================================================
// ADMISSIONS MODULE MODELS
// ==================================================

enum AdmissionMethod {
  BULK_IMPORT
  QR_CODE
  ADMISSION_CODE
}

enum AdmissionStatus {
  SUCCESS
  ALREADY_ADMITTED
  FAILED
}

enum AdmissionCodeStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  REVOKED
}

model AdmissionBatch {
  id           String   @id @default(uuid()) @db.Uuid
  academyId    String   @db.Uuid
  fileName     String
  totalRows    Int
  successCount Int      @default(0)
  failedCount  Int      @default(0)
  skippedCount Int      @default(0)
  createdById  String   @db.Uuid
  createdAt    DateTime @default(now())

  academy   Academy           @relation(fields: [academyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy User              @relation("AdmissionBatchCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  records   AdmissionRecord[]

  @@index([academyId, createdAt])
}

model AdmissionRecord {
  id            String          @id @default(uuid()) @db.Uuid
  academyId     String          @db.Uuid
  batchId       String?         @db.Uuid
  studentId     String?         @db.Uuid
  email         String
  studentName   String          @default("")
  method        AdmissionMethod
  codeId        String?         @db.Uuid
  status        AdmissionStatus @default(SUCCESS)
  failureReason String?
  createdById   String?         @db.Uuid
  createdAt     DateTime        @default(now())
  completedAt   DateTime?

  academy   Academy         @relation(fields: [academyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  batch     AdmissionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  student   User?           @relation("AdmissionStudent", fields: [studentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy User?           @relation("AdmissionRecordCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  code      AdmissionCode?  @relation(fields: [codeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([academyId, method, createdAt])
  @@index([email])
  @@index([createdById])
}

model AdmissionCode {
  id          String              @id @default(uuid()) @db.Uuid
  academyId   String              @db.Uuid
  code        String              @unique @db.VarChar(16)
  maxUses     Int?
  currentUses Int                 @default(0)
  status      AdmissionCodeStatus @default(ACTIVE)
  expiresAt   DateTime?
  createdById String              @db.Uuid
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  academy   Academy           @relation(fields: [academyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy User              @relation("AdmissionCodeCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  records   AdmissionRecord[]

  @@index([academyId, status, expiresAt])
}

// ==================================================
// PHASE 10 — ACADEMY NOTIFICATIONS ENUMS
// ==================================================

enum NotificationType {
  ANNOUNCEMENT
  ACADEMIC_UPDATE
  EVENT
  REMINDER
  ALERT
}

enum NotificationPriority {
  NORMAL
  HIGH
  URGENT
}

enum NotificationTargetType {
  ALL_STUDENTS
  COURSE
  INDIVIDUAL_STUDENTS
}

enum NotificationStatus {
  DRAFT
  SCHEDULED
  PROCESSING
  SENT
  CANCELLED
}

// ==================================================
// PHASE 10 — ACADEMY NOTIFICATIONS MODELS
// ==================================================

model Notification {
  id                  String                 @id @default(uuid()) @db.Uuid
  academyId           String                 @db.Uuid
  senderId            String                 @db.Uuid
  title               String
  body                String                 @db.Text
  type                NotificationType       @default(ANNOUNCEMENT)
  priority            NotificationPriority   @default(NORMAL)
  targetType          NotificationTargetType @default(ALL_STUDENTS)
  targetCourseId      String?                @db.Uuid
  status              NotificationStatus     @default(DRAFT)
  scheduledAt         DateTime?
  sentAt              DateTime?
  totalRecipients     Int                    @default(0)
  readCount           Int                    @default(0)
  processingStartedAt DateTime?
  dispatchAttempts    Int                    @default(0)
  lastDispatchError   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  academy           Academy                        @relation(fields: [academyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sender            User                           @relation("SentNotifications", fields: [senderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  targetCourse      Course?                        @relation(fields: [targetCourseId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  recipients        NotificationRecipient[]
  individualTargets NotificationIndividualTarget[]
  deliveries        NotificationDelivery[]

  @@index([academyId, status, deletedAt])
  @@index([academyId, createdAt])
  @@index([status, scheduledAt])
}

model NotificationRecipient {
  id             String    @id @default(uuid()) @db.Uuid
  notificationId String    @db.Uuid
  studentUserId  String?   @db.Uuid
  academyId      String    @db.Uuid
  isRead         Boolean   @default(false)
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  studentUser  User?        @relation("ReceivedNotificationRecipients", fields: [studentUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  academy      Academy      @relation(fields: [academyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([notificationId, studentUserId])
  @@index([studentUserId, isRead, createdAt])
  @@index([academyId, notificationId])
}

model NotificationIndividualTarget {
  notificationId String   @db.Uuid
  studentUserId  String   @db.Uuid
  academyId      String   @db.Uuid
  createdAt      DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  studentUser  User         @relation(fields: [studentUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academy      Academy      @relation(fields: [academyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([notificationId, studentUserId])
  @@index([academyId, studentUserId])
}

model NotificationTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  academyId String   @db.Uuid
  title     String
  body      String   @db.Text
  category  String   @default("GENERAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([academyId, category])
}

// ==================================================
// PHASE 2C — OPERATIONAL RELIABILITY MODELS
// ==================================================

model StorageUpload {
  id             String    @id @default(uuid()) @db.Uuid
  academyId      String?   @db.Uuid
  courseId       String?   @db.Uuid
  createdById    String    @db.Uuid
  objectKey      String    @unique
  originalName   String
  mimeType       String
  sizeBytes      BigInt
  checksumSha256 String    @db.VarChar(64)
  purpose        String
  status         String    @default("PENDING")
  expiresAt      DateTime
  finalizedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  academy   Academy? @relation(fields: [academyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([academyId, status, expiresAt])
  @@index([createdById, createdAt])
}

model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  scope        String
  key          String
  requestHash  String   @db.VarChar(64)
  responseCode Int
  responseBody Json
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@unique([scope, key])
  @@index([expiresAt])
}

model BackgroundJob {
  id               String    @id @default(uuid()) @db.Uuid
  academyId        String?   @db.Uuid
  createdById      String?   @db.Uuid
  kind             String
  deduplicationKey String?
  payload          Json
  status           String    @default("PENDING")
  runAt            DateTime  @default(now())
  lockedAt         DateTime?
  lockedBy         String?
  attemptCount     Int       @default(0)
  maxAttempts      Int       @default(5)
  lastError        String?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  academy   Academy? @relation(fields: [academyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdBy User?    @relation("BackgroundJobCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([kind, deduplicationKey])
  @@index([status, runAt, lockedAt])
  @@index([academyId, createdAt])
}

model ContactSubmission {
  id        String   @id @default(uuid()) @db.Uuid
  academyId String?  @db.Uuid
  userId    String?  @db.Uuid
  name      String
  email     String
  phone     String?
  subject   String
  message   String   @db.Text
  source    String   @default("PUBLIC_API")
  status    String   @default("RECEIVED")
  ipHash    String?  @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy Academy? @relation(fields: [academyId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status, createdAt])
  @@index([academyId, createdAt])
}

model PaymentWebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String
  eventType       String
  payloadHash     String    @db.VarChar(64)
  status          String    @default("RECEIVED")
  lastError       String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@unique([provider, providerEventId])
  @@index([status, createdAt])
}

model UserAcademyPreference {
  userId    String   @id @db.Uuid
  academyId String   @db.Uuid
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([academyId])
}

model NotificationDelivery {
  id                String    @id @default(uuid()) @db.Uuid
  notificationId    String    @db.Uuid
  academyId         String    @db.Uuid
  recipientUserId   String?   @db.Uuid
  channel           String
  status            String    @default("PENDING")
  idempotencyKey    String    @unique
  providerMessageId String?
  attemptCount      Int       @default(0)
  lastError         String?
  nextAttemptAt     DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  notification  Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  academy       Academy      @relation(fields: [academyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  recipientUser User?        @relation(fields: [recipientUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status, nextAttemptAt])
  @@index([notificationId, channel])
  @@index([academyId, createdAt])
}
