enum AcademyStatus {
  ACTIVE
  PENDING
  SUSPENDED
  ARCHIVED
}

enum AcademyMemberRole {
  ACADEMY_ADMIN
  ACADEMY_TEACHER
  ACADEMY_STUDENT
}

enum AcademyMemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REVOKED
}

enum AcademyInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ==================================================
// PHASE 8 — ACADEMY MULTI-TENANT MODELS
// ==================================================

model Academy {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  name        String
  email       String        @unique
  phone       String
  address     String
  city        String
  state       String
  country     String        @default("India")
  postalCode  String
  website     String        @default("")
  description String        @default("")
  logoUrl     String?       @default("")
  status      AcademyStatus @default(PENDING)

  adminName  String
  adminEmail String
  adminPhone String @default("")

  // Cached Denormalized Aggregates
  studentCount       Int     @default(0)
  activeStudentCount Int     @default(0)
  courseCount        Int     @default(0)
  activeCourseCount  Int     @default(0)
  packageCount       Int     @default(0)
  orderCount         Int     @default(0)
  revenue            Decimal @default(0.00) @db.Decimal(12, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  memberships                   AcademyMembership[]
  invitations                   AcademyInvitation[]
  qrSessions                    AcademyQrSession[]
  courses                       AcademyCourse[]
  tenantCourses                 Course[]
  questions                     Question[]
  broadcasts                    Broadcast[]
  enrollments                   AcademyCourseEnrollment[]
  broadcastTargets              BroadcastAcademyTarget[]
  systemAuditLogs               SystemAuditLog[]
  securityEvents                SecurityEvent[]
  notifications                 Notification[]
  notificationRecipients        NotificationRecipient[]
  notificationTemplates         NotificationTemplate[]
  notificationIndividualTargets NotificationIndividualTarget[]
  admissionBatches              AdmissionBatch[]
  admissionRecords              AdmissionRecord[]
  admissionCodes                AdmissionCode[]
  storageUploads                StorageUpload[]
  backgroundJobs                BackgroundJob[]
  contactSubmissions            ContactSubmission[]
  activeUserPreferences         UserAcademyPreference[]
  notificationDeliveries        NotificationDelivery[]

  @@index([status, deletedAt])
  @@index([email])
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model AcademyCourseEnrollment {
  id          String           @id @default(uuid()) @db.Uuid
  academyId   String           @db.Uuid
  studentId   String           @db.Uuid
  courseId    String           @db.Uuid
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  student User    @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([studentId, courseId])
  @@index([academyId, status])
  @@index([studentId, status])
  @@index([courseId])
}

model AcademyMembership {
  id        String              @id @default(uuid()) @db.Uuid
  academyId String              @db.Uuid
  userId    String              @db.Uuid
  role      AcademyMemberRole   @default(ACADEMY_STUDENT)
  status    AcademyMemberStatus @default(ACTIVE)
  joinedAt  DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, academyId])
  @@index([academyId, role, status])
  @@index([userId, status])
}

model AcademyInvitation {
  id          String                  @id @default(uuid()) @db.Uuid
  academyId   String                  @db.Uuid
  email       String
  studentName String                  @default("")
  role        AcademyMemberRole       @default(ACADEMY_STUDENT)
  status      AcademyInvitationStatus @default(PENDING)
  invitedBy   String                  @db.Uuid
  expiresAt   DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  inviter User    @relation("AcademyInviter", fields: [invitedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([academyId, email, status])
  @@index([email, status])
}

model AcademyQrSession {
  id          String    @id @default(uuid()) @db.Uuid
  academyId   String    @db.Uuid
  tokenHash   String    @unique
  createdById String    @db.Uuid
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  academy   Academy @relation(fields: [academyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdBy User    @relation("QrCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([academyId, expiresAt])
  @@index([academyId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model AcademyCourse {
  id          String    @id @default(uuid()) @db.Uuid
  academyId   String    @db.Uuid
  name        String
  description String    @default("")
  status      String    @default("DRAFT")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  academy  Academy          @relation(fields: [academyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contents AcademyContent[]

  @@index([academyId, status, deletedAt])
}

model AcademyContent {
  id           String    @id @default(uuid()) @db.Uuid
  courseId     String    @db.Uuid
  title        String
  description  String    @default("")
  kind         String
  mimeType     String?
  size         BigInt    @default(0)
  storagePath  String?
  displayOrder Int       @default(0)
  status       String    @default("PUBLISHED")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  course AcademyCourse @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([courseId, status, deletedAt, displayOrder])
}

model BroadcastAcademyTarget {
  id          String @id @default(uuid()) @db.Uuid
  broadcastId String @db.Uuid
  academyId   String @db.Uuid

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  academy   Academy   @relation(fields: [academyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([broadcastId, academyId])
  @@index([broadcastId])
  @@index([academyId])
}

